Options -Indexes
Options -MultiViews

RewriteEngine On
RewriteBase /

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  <FilesMatch "\.(php|html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# ════════════════════════════════════════
#  PHP HATA GİZLEME
#  Not: Paylaşımlı hostingde php.ini üzerinden ayarlanır
# ════════════════════════════════════════

# ════════════════════════════════════════
#  HTTPS ZORLA (prod'da aktif et)
# ════════════════════════════════════════
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# ════════════════════════════════════════
#  GÜVENLİK: hassas dosyalara erişimi engelle
# ════════════════════════════════════════
RewriteRule ^db\.php$             - [F,L]
RewriteRule ^core/db\.php$        - [F,L]
RewriteRule ^core/.*\.php$        - [F,L]
RewriteRule ^\.env$               - [F,L]
RewriteRule ^\.git                - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule ^package(-lock)?\.json$ - [F,L]

# ════════════════════════════════════════
#  ÜRÜN DOSYALARI: doğrudan erişim yasak
#  Sadece tek kullanımlık token ile (api/download) indirilir
# ════════════════════════════════════════
RewriteRule ^uploads/products/ - [F,L]
RewriteRule ^uploads/versions/ - [F,L]
<IfModule mod_headers.c>
    <FilesMatch "\.(zip|rar|7z|tar|gz|exe|pdf|txt|sql)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>



# ════════════════════════════════════════
#  GERÇEK DOSYA/DİZİN VARSA DOKUNMA
#  (assets, images vb. için — PHP değil)
# ════════════════════════════════════════
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !\.php$
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ════════════════════════════════════════
#  TEMİZ URL'LER
# ════════════════════════════════════════

# Ana sayfa
RewriteRule ^$                    index.php             [L]

# Auth
RewriteRule ^login$               auth/login.php        [L]
RewriteRule ^register$            auth/register.php     [L]
RewriteRule ^logout$              auth/logout.php       [L]
RewriteRule ^banned$              banned.php            [L]

# Kullanıcı paneli
RewriteRule ^dashboard$           user/index.php        [L]
RewriteRule ^dashboard/([a-z0-9_-]+)$ user/$1.php       [L]

# Admin paneli
RewriteRule ^admin$               admin/index.php       [L]
RewriteRule ^admin/([a-z0-9_-]+)$ admin/$1.php          [L]

# Lisans sorgulama
RewriteRule ^license-check$      license-check.php    [L]

# Özellikler
RewriteRule ^features$            features.php         [L]

# Fiyatlandırma
RewriteRule ^pricing$             pricing.php          [L]

# Sitemap
RewriteRule ^sitemap\.xml$        sitemap.php          [L]

# Yasal sayfalar (.php uzantısı gizli)
RewriteRule ^terms-of-use$       terms-of-use.php     [L]
RewriteRule ^privacy-policy$     privacy-policy.php   [L]
RewriteRule ^cookie-policy$      cookie-policy.php    [L]

# Blog
RewriteRule ^blog$               blog.php             [L]
RewriteRule ^blog/([A-Za-z0-9_-]+)/?$  blog-post.php?slug=$1 [QSA,L]
# Toleranslı fallback: query string düşse bile blog-post.php REQUEST_URI'den slug'ı çözer
RewriteRule ^blog/(.+)$          blog-post.php        [QSA,L]

# Blog yazilari kok-seviye canonical URL kullanir (or. /ornek-yazi).
# Ustteki ozel rotalar [L] ile once eslestigi icin bu kural yalnizca
# bilinmeyen tek-segment yollara duser; blog-post.php olmayan slug'da 404 verir.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_-]+)/?$  blog-post.php?slug=$1 [QSA,L]

# Ic ice (nested) blog URL'leri — kok canonical, dogrudan 200 verir.
RewriteRule ^sellfy/alternatives-2026/?$ blog-post.php?slug=sellfy/alternatives-2026 [QSA,L]
RewriteRule ^gumroad/alternative-2026/?$ blog-post.php?slug=gumroad/alternative-2026 [QSA,L]

# API
RewriteRule ^api/plan-checkout$   api/plan-checkout.php [L]
RewriteRule ^api/whop-checkout$   api/whop-checkout.php [L]
RewriteRule ^api/whop-webhook$    api/whop-webhook.php  [L]
RewriteRule ^api/([a-z0-9_-]+)$   api/$1.php            [L]
RewriteRule ^api/([a-z0-9_-]+)/([a-z0-9_-]+)$ api/$1/$2.php [L]

# ════════════════════════════════════════
#  GÜVENLİK BAŞLIKLARI
# ════════════════════════════════════════
<IfModule mod_headers.c>
    Header set X-Frame-Options         "SAMEORIGIN"
    Header set X-XSS-Protection        "1; mode=block"
    Header set X-Content-Type-Options  "nosniff"
    Header set Referrer-Policy         "strict-origin-when-cross-origin"
    Header set Permissions-Policy      "geolocation=(), microphone=(), camera=()"
    # HSTS — sadece HTTPS'de aktif et
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ════════════════════════════════════════
#  GZIP SIKIŞTIRMA
# ════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ════════════════════════════════════════
#  BROWSER CACHE (statik dosyalar)
# ════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png             "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 1 month"
    ExpiresByType image/webp            "access plus 1 month"
    ExpiresByType image/svg+xml         "access plus 1 month"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType text/css              "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff             "access plus 1 month"
    ExpiresByType font/woff2            "access plus 1 month"
</IfModule>

# ════════════════════════════════════════
#  CHARSET & MIME TYPES
# ════════════════════════════════════════
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType application/javascript    .js
    AddType text/css                  .css
    AddType image/webp                .webp
    AddType font/woff                 .woff
    AddType font/woff2                .woff2
</IfModule>
